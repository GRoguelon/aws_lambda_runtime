#!/bin/sh

# Sourced by bin/lambda before any defaults are applied. These mirror what
# `priv/bootstrap` exports so the release also behaves under the Runtime
# Interface Emulator or when invoked directly.

export RELEASE_TMP="${RELEASE_TMP:-/tmp}"
<%= if handler = @release.options[:aws_lambda_runtime][:handler] do %>
# The handler given to AWS.Lambda.Runtime.Release.lambda/1, which takes
# precedence over the application config and the function's Handler setting.
export RELEASE_LAMBDA_HANDLER="<%= handler %>"
<% end %>
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"

# Load modules on first use rather than all of them at boot: the init phase
# is part of every cold start, and a function rarely calls every module of
# every application. Set RELEASE_MODE=embedded on the function to preload.
export RELEASE_MODE="${RELEASE_MODE:-interactive}"

# The VM sees the host's core count, not the cgroup CPU share. Lambda gives
# one vCPU per 1769 MB of memory (fractional below), so run one scheduler per
# vCPU: ceil(memory / 1769), i.e. 1 up to 1769 MB, 6 at 10240 MB. Dirty CPU
# schedulers follow. Skipped when the memory size is unknown (the VM default
# applies) or when ELIXIR_ERL_OPTIONS already sets +S.
#
# On Lambda Managed Instances, which set AWS_LAMBDA_MAX_CONCURRENCY, the vCPUs
# don't follow the memory size: the VM's own count, from the CPUs it is
# given, stands.
case "${AWS_LAMBDA_MAX_CONCURRENCY:+managed}${AWS_LAMBDA_FUNCTION_MEMORY_SIZE:-}" in
  managed*) ;;
  '' | *[!0-9]*) ;;
  *)
    case " ${ELIXIR_ERL_OPTIONS:-} " in
      *" +S "*) ;;
      *)
        schedulers=$(( (AWS_LAMBDA_FUNCTION_MEMORY_SIZE + 1768) / 1769 ))
        export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:+$ELIXIR_ERL_OPTIONS }+S $schedulers:$schedulers"
        ;;
    esac
    ;;
esac

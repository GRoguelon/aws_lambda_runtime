#!/bin/sh
# Lambda executes this file (mode 0755, at the root of the package) as the
# entrypoint of a `provided.al2023` function.
set -e

# Built with `include_erts: false`, the release picks up `erl` from PATH, so
# from the OTP layer unpacked at /opt. With `include_erts: true` it runs its
# own ERTS, its shared libraries in lib/ (on Lambda's LD_LIBRARY_PATH), and
# this is unused.
export PATH="/opt/otp/bin:$PATH"

# /var/task and /opt are read only; /tmp is the only writable location. The
# release start script materialises sys.config and vm.args under RELEASE_TMP.
export RELEASE_TMP=/tmp
export HOME=/tmp

# No epmd, no node name, no distribution — nothing to connect to and it costs
# startup time.
export RELEASE_DISTRIBUTION=none

# A crash dump would try to write to a read-only filesystem and stall shutdown.
export ERL_CRASH_DUMP=/dev/null
export ERL_CRASH_DUMP_SECONDS=0

# Keep flags set in the function's environment (e.g. +S, which then takes
# precedence over the one env.sh derives from the memory size).
export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:+$ELIXIR_ERL_OPTIONS }-noinput"

RELEASE_SCRIPT="${LAMBDA_TASK_ROOT:-/var/task}/bin/lambda"

# The release must be named `lambda`; fail with a clear message in the
# function's logs rather than a bare "not found".
if [ ! -x "$RELEASE_SCRIPT" ]; then
  echo "bootstrap: $RELEASE_SCRIPT not found, the release must be named \`lambda\`" >&2
  exit 1
fi

# exec so the VM becomes the process Lambda supervises and receives its signals.
exec "$RELEASE_SCRIPT" start
